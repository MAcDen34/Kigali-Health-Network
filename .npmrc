# Next.js 14.2 declares react/react-dom ^18 as a peer dependency — React 19
# support only became official in Next.js 15. We're intentionally running
# React 19 on Next 14.2 anyway (tested and working), so this override is
# required for `npm install` to succeed at all; without it, a clean install
# hard-fails on the peer conflict instead of just warning.
legacy-peer-deps=true
