# ─────────────────────────────────────────────────────────────────────────────
# Kigali Unified Patient Records & Insurance Network — Environment Config
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (Vite — prefix with VITE_ to expose to the browser) ─────────────
# HAProxy entry point: all API calls are routed here
VITE_API_BASE_URL=http://localhost:80/api

# ── Backend shared secrets ────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kigali_health
DB_USER=admin
DB_PASSWORD=replace-with-secure-password

# Full DSN (used by SQLAlchemy / Alembic in each service)
DATABASE_URL=postgresql+asyncpg://admin:replace-with-secure-password@postgres:5432/kigali_health

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Service ports (internal Docker networking) ────────────────────────────────
RECORDS_SERVICE_PORT=8000
CLINICAL_SERVICE_PORT=8001
PHARMACY_SERVICE_PORT=8002
INSURANCE_SERVICE_PORT=8003
ADMIN_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005

# ── Notification service ──────────────────────────────────────────────────────
# SMS provider (e.g. Twilio, Africa's Talking)
NOTIFY_SMS_PROVIDER=africas_talking
NOTIFY_SMS_API_KEY=replace-with-sms-api-key
NOTIFY_SMS_FROM=+250XXXXXXXXX

# Email (SMTP)
NOTIFY_SMTP_HOST=smtp.gmail.com
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=no-reply@kigalihealthnetwork.rw
NOTIFY_SMTP_PASSWORD=replace-with-smtp-password

# ── HAProxy ───────────────────────────────────────────────────────────────────
HAPROXY_STATS_PORT=8404
HAPROXY_STATS_PASSWORD=replace-with-stats-password

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Initial platform admin account (created on first migration seed)
ADMIN_EMAIL=admin@kigalihealthnetwork.rw
ADMIN_PASSWORD=replace-with-admin-password

# ── Development flags ─────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=info
